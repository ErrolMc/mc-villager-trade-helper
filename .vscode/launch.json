{
	// F5 starts the dev client through Gradle and attaches the debugger, so breakpoints and hot code replace work.
	// Not generated by `gradlew vscode`: that launches from VS Code's own build output, which skips Gradle's
	// resource processing. Don't run that task, it would overwrite this file.
	"version": "0.2.0",
	"configurations": [
		{
			"type": "java",
			"name": "Minecraft Client",
			"request": "attach",
			"hostName": "localhost",
			"port": 5005,
			"timeout": 120000,
			"preLaunchTask": "Start client for debugging",
			"projectName": "villager-trade-helper"
		}
	]
}
